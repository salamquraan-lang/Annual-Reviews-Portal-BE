DATABASE_URL="mysql+pymysql://user:password@localhost:3306/employee_review"

PORT=4000
NODE_ENV=development
APP_URL="http://localhost:5173"
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

JWT_ACCESS_SECRET=""

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
VERIFY_EMAIL_TTL_HOURS=24
RESET_PASSWORD_TTL_MINUTES=30

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Leave SMTP_HOST empty to write emails to tmp/mail/ instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Employee Review <no-reply@example.test>"
